# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TIMEZONE: America/Sao_Paulo (Horário Oficial de Brasília)
TZ="America/Sao_Paulo"

# INTEGRAÇÃO DE AGENDAMENTO E GOOGLE MEET (Opcional em produção)
# Configuração para Google Calendar API corporativa da ACI Del-Rei / Vortex:
GOOGLE_CALENDAR_CLIENT_ID="seu-cliente-google-oauth.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_CALENDAR_ID="agenda@acidelrei.org.br"

# SERVIÇO DE DISPARO DE E-MAILS TRANSACIONAIS (Opcional em produção)
# Configuração SMTP institucional para envio automático do relatório PDF:
SMTP_HOST="smtp.acidelrei.org.br"
SMTP_PORT="587"
SMTP_USER="diagnostico@acidelrei.org.br"
SMTP_PASS=""
SMTP_FROM_NAME="Diagnóstico Cresce Del-Rei"
SMTP_FROM_EMAIL="diagnostico@acidelrei.org.br"

# INTEGRAÇÃO COM CRM DA VORTEX
# Webhook/API endpoint para recebimento automático dos leads de consultoria e diagnósticos:
VITE_VORTEX_CRM_WEBHOOK_URL="https://crm.vortextecnologia.com.br/api/webhooks/cresce-delrei"

# SEGURANÇA E ACESSO ADMINISTRATIVO
ADMIN_SECRET_KEY="admin123"
